# Copy to .env and fill in. .env is git-ignored.

# Which backend to use: "anthropic" or "ollama"
DOCAUDIT_LLM_PROVIDER=ollama

# --- Anthropic (Claude) ---
DOCAUDIT_ANTHROPIC_API_KEY=
DOCAUDIT_ANTHROPIC_MODEL=claude-haiku-5-5

# --- Ollama (local) ---
DOCAUDIT_OLLAMA_BASE_URL=http://localhost:11434
DOCAUDIT_OLLAMA_MODEL=llama3.1:8b
DOCAUDIT_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- API (Lesson 6) ---
# Required in the X-API-Key header when set. Leave empty only on your own machine.
DOCAUDIT_API_KEY=
