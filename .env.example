# Copy to .env and fill in. .env is git-ignored.

# Which backend to use: "anthropic" or "ollama"
DOCAUDIT_LLM_PROVIDER=ollama

# --- Anthropic (Claude) ---
DOCAUDIT_ANTHROPIC_API_KEY=
DOCAUDIT_ANTHROPIC_MODEL=claude-haiku-5-5

# --- Ollama (local) ---
DOCAUDIT_OLLAMA_BASE_URL=http://localhost:11434
DOCAUDIT_OLLAMA_MODEL=llama3.1:8b
